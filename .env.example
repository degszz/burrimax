# Copiar como .env en apps/web y apps/admin (los .env no se commitean).
# Proyecto de desarrollo: burritos-dev (https://qoxzylgpstmzjzgxnetw.supabase.co)

# Públicas: se pueden mandar al navegador.
PUBLIC_SUPABASE_URL=https://qoxzylgpstmzjzgxnetw.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública del sitio (para el webhook y la vuelta de Mercado Pago). En local se puede dejar vacía.
PUBLIC_SITE_URL=

# Secretas: SOLO servidor. Nunca con prefijo PUBLIC_.
# Supabase → Project Settings → API Keys → Secret keys. Sin esta, la web no toma pedidos.
SUPABASE_SECRET_KEY=
# Mercado Pago Developers → tu aplicación → Credenciales de PRUEBA (en producción, las de producción).
MP_ACCESS_TOKEN=
# Mercado Pago → tu aplicación → Webhooks → Firma secreta. URL: https://TU-DOMINIO/api/webhooks/mercadopago
MP_WEBHOOK_SECRET=
