---
import '@/styles/global.css';
import { MARCA, tituloPagina } from '@/lib/marca';

interface Props {
  /** Nombre de la página ("Tu pedido"). Sin nada: la portada. */
  titulo?: string;
  descripcion?: string;
  /** false en páginas privadas (checkout, seguimiento): no aparecen en Google. */
  indexar?: boolean;
  /** Ruta de la imagen para compartir (1200×630). */
  imagen?: string;
  /** Datos para Google (schema.org), solo en la portada. */
  datosEstructurados?: Record<string, unknown>;
}

const { titulo, descripcion = MARCA.descripcion, indexar = true, imagen = '/og.png?v=2', datosEstructurados } = Astro.props;

// La dirección pública manda (PUBLIC_SITE_URL o la de la marca), así los links
// compartidos apuntan siempre al dominio bueno y no a una URL de prueba.
const sitio = (import.meta.env.PUBLIC_SITE_URL || MARCA.sitio).replace(/\/$/, '');
const canonica = `${sitio}${Astro.url.pathname}`;
const urlImagen = new URL(imagen, sitio).href;
const tituloCompleto = tituloPagina(titulo);
// En la vista previa se ve mejor sin el " · Burrimax" al final.
const tituloCompartir = titulo ? `${titulo} · ${MARCA.nombre}` : `${MARCA.nombre} · ${MARCA.frase}`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex, nofollow" />}

    <!-- Vista previa al compartir (WhatsApp, Instagram, Facebook, Telegram) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={MARCA.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={tituloCompartir} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:secure_url" content={urlImagen} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${MARCA.nombre}: armá tu burrito a tu gusto, con papas fritas incluidas`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompartir} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={urlImagen} />

    <!-- Íconos y color del navegador -->
    <meta name="theme-color" content={MARCA.colorFondo} />
    <meta name="application-name" content={MARCA.nombre} />
    <meta name="apple-mobile-web-app-title" content={MARCA.nombre} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@500;600;700;800&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    {datosEstructurados && <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />}
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-crema text-tinta antialiased">
    <slot />
  </body>
</html>
