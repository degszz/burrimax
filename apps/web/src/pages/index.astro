---
import Tienda from '@/components/Tienda';
import Base from '@/layouts/Base.astro';
import { cargarDatosTienda, type DatosTienda } from '@/lib/catalogo.server';

// La home es el armador. El catálogo se lee en cada visita (cambia desde el admin).
let datos: DatosTienda | null = null;
try {
  datos = await cargarDatosTienda();
} catch (error) {
  console.error(error);
  Astro.response.status = 503;
}

// Precarga las tortillas: son lo primero que se ve.
const tortillas = datos?.catalogo.ingredientes.filter((i) => i.categoria === 'tortilla' && i.imagenUrl) ?? [];
---

<Base titulo="Armá tu burrito · [NOMBRE A CONFIRMAR]">
  <Fragment slot="head">
    {tortillas.map((t) => <link rel="preload" as="image" type="image/avif" href={t.imagenUrl} />)}
  </Fragment>
  {
    datos ? (
      <Tienda client:load catalogo={datos.catalogo} combosCasa={datos.combosCasa} abierto={datos.abierto} whatsapp={datos.config.whatsapp} />
    ) : (
      <main class="mx-auto grid min-h-dvh max-w-md place-items-center px-6 text-center">
        <div>
          <p class="text-5xl" aria-hidden="true">🌯</p>
          <h1 class="mt-3 text-3xl font-extrabold">No pudimos cargar el menú</h1>
          <p class="mt-2 text-lg text-tinta-suave">Puede ser la conexión. Probá de nuevo en un ratito.</p>
          <a
            href="/"
            class="juguete mt-6 inline-flex min-h-14 items-center rounded-2xl bg-rojo px-6 font-heading text-xl font-extrabold text-white"
          >
            Probar de nuevo
          </a>
        </div>
      </main>
    )
  }
</Base>
