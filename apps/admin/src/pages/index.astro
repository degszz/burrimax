---
import TableroPedidos from '@/components/TableroPedidos';
import Base from '@/layouts/Base.astro';

// Pantalla principal (pensada para una tablet en la cocina).
// El middleware ya verificó sesión + rol admin + código del celular.
---

<Base titulo="Pedidos" conMenu activo="pedidos">
  <TableroPedidos client:load />
</Base>

<style is:global>
  @media print {
    @page {
      margin: 4mm;
      size: 80mm auto;
    }
  }
</style>
