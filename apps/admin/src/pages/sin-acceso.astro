---
import Base from '@/layouts/Base.astro';
---

<Base titulo="Sin acceso">
  <main class="grid min-h-dvh place-items-center px-4 text-center">
    <div class="max-w-sm space-y-3">
      <h1 class="text-2xl font-bold">Esta cuenta no tiene acceso al panel</h1>
      <p class="text-zinc-600">Si sos del equipo, pedile al dueño que te habilite.</p>
      <a href="/login" class="inline-block rounded-lg bg-zinc-900 px-5 py-3 font-bold text-white">Volver</a>
    </div>
  </main>
</Base>
